// ElavoFishAI — full data model, designed up front (P0) so later phases (social,
// admin, monetization) are additive migrations, not reshapes.
//
// Phase use:
//   P1  User, AuthToken, Session, RateLimit, Lake, LakeProfile, UserLake, Kv
//   P2  Trip, Spot, Waypoint (normalized + visibility), Friendship, FriendGroup(+Member), SharingPref
//   P3  AuditLog, ProfileContribution
//   P4  (future) marketplace + subscriptions — Role already has pro|guide and
//       Visibility already has `paid`; reserve Listing/Purchase/Entitlement/Payout/
//       Subscription as additive tables then.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  pro
  guide
  admin
}

enum AuthPurpose {
  login
  signup
}

enum GaugeSource {
  usgs
  manual
  none
}

enum LakeProfileSource {
  ai
  hand_verified
  community
}

// Sharing scale — social tiers now, `paid` reserved for the P4 marketplace.
enum Visibility {
  private
  friends
  group
  public
  paid
}

enum FriendshipStatus {
  pending
  accepted
  blocked
}

enum ShareScope {
  none
  friends
  groups
  public
}

enum ShareDataType {
  trips
  spots
  waypoints
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  displayName String
  username    String?   @unique
  avatarUrl   String?   @db.Text // data URL (client-resized square) or external URL
  role        Role      @default(user)
  status      String    @default("active") // active | suspended
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // ---- profile ----
  location        String? // e.g. "Granbury, TX"
  bio             String?   @db.Text
  favoriteSpecies String? // e.g. "Largemouth Bass"
  favoriteLure    String? // e.g. "1/16 oz chartreuse jig"
  // ---- electronics ---- what the angler actually runs, so the app stops
  // assuming Garmin + LiveScope. null = never asked, "none" = fishes without.
  plotterBrand    String? // garmin | lowrance | humminbird | other | none
  ffsBrand        String? // livescope | activetarget | megalive | other | none
  hasBoat         Boolean? // null = never asked
  boatType        String? // bass boat | pontoon | kayak | jon boat | bank & wade ...
  yearsFishing    String? // free text band, e.g. "10+ years"
  onboardedAt     DateTime? // completed the first-run flow
  termsAcceptedAt DateTime? // when they accepted, and which version
  termsVersion    String?
  favoriteLakeId  String?
  favoriteLake    Lake?     @relation("UserFavoriteLake", fields: [favoriteLakeId], references: [id], onDelete: SetNull)

  // ---- discoverability ----
  // Who can find this angler by searching. `friends_of_friends` (the default)
  // means someone must share at least one accepted friend. `nobody` keeps them
  // out of search entirely — a request by exact email still reaches them,
  // because knowing the address is its own kind of introduction.
  discoverability String @default("friends_of_friends") // everyone | friends_of_friends | nobody
  // Who a new post goes to when the angler doesn't pick. Friends, unless they
  // have deliberately opened up — nothing is public by default.
  postDefault     String @default("friends") // private | friends | public

  // ---- messaging ----
  messagePrivacy   String    @default("friends") // everyone | friends | nobody
  sentMessages     Message[] @relation("MsgSender")
  receivedMessages Message[] @relation("MsgRecipient")

  sessions             Session[]
  userLakes            UserLake[]
  addedLakes           Lake[]                @relation("LakeAddedBy")
  trips                Trip[]
  spots                Spot[]
  waypoints            Waypoint[]
  kv                   Kv[]
  sharingPrefs         SharingPref[]
  ownedGroups          FriendGroup[]         @relation("GroupOwner")
  groupMemberships     FriendGroupMember[]
  friendshipsInitiated Friendship[]          @relation("FriendshipUser")
  friendshipsReceived  Friendship[]          @relation("FriendshipFriend")
  auditLogs            AuditLog[]
  profileContributions ProfileContribution[]
  reports              LakeReport[]
  planFeedback         PlanFeedback[]
  photos               Photo[]
  posts                Post[]
  comments             PostComment[]
  reactions            PostReaction[]
  listings             Listing[]
  notifications        Notification[]        @relation("NotifyRecipient")
  actedNotifications   Notification[]        @relation("NotifyActor")
  flagsRaised          ContentFlag[]         @relation("FlagReporter")
  invitesSent          Invite[]              @relation("InviteSender")
  tournamentsRun       Tournament[]          @relation("TournamentHost")
  tournamentEntries    TournamentEntry[]
  inviteAccepted       Invite[]              @relation("InviteAcceptor")
}

// Magic-link tokens. Unified login+signup: purpose distinguishes; displayName is
// captured when a brand-new email requests a link.
model AuthToken {
  id          String      @id @default(cuid())
  email       String
  tokenHash   String      @unique
  purpose     AuthPurpose @default(login)
  displayName String?
  // The invite this signup came through, if any. Without it we cannot tell a
  // link-driven signup from someone who happened to sign up later, and an
  // invite planted at a stranger's address would silently befriend them.
  inviteCode  String?
  expiresAt   DateTime
  usedAt      DateTime?
  ip          String?
  createdAt   DateTime    @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Bounded rate-limit buckets (e.g. "magiclink:<ip>") — swept, never grows forever.
model RateLimit {
  id          String   @id @default(cuid())
  bucket      String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// Lakes are GLOBAL and deduped — one row per real body of water, shared by all users.
model Lake {
  id           String      @id @default(cuid())
  name         String
  region       String? // state / province
  country      String?
  lat          Float
  lon          Float
  gaugeId      String?
  gaugeSource  GaugeSource @default(none)
  fullPool     Float?
  bbox         String? // JSON [w,s,e,n]
  rampsJson    String?     @db.Text // cached OSM boat ramps for this lake
  rampsAt      DateTime? // when that cache was filled
  featuresJson String?     @db.Text // cached named features (creek mouths, points, bridges, dams…)
  featuresAt   DateTime?
  corpsProject String? // "SWF:WTYT2" — nearest USACE project, "" = none nearby
  corpsAt      DateTime?
  osmRef       String?     @unique // e.g. "way/12345678"
  addedById    String?
  addedBy      User?       @relation("LakeAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  profile       LakeProfile?
  userLakes     UserLake[]
  trips         Trip[]
  posts         Post[]
  listings      Listing[]
  tournaments   Tournament[]
  spots         Spot[]
  waypoints     Waypoint[]
  dayPlans      DayPlan[]
  contributions ProfileContribution[]
  reports       LakeReport[]
  favoritedBy   User[]                @relation("UserFavoriteLake")

  @@index([name])
}

// ---- Direct messages (friends-only by default; per-user privacy setting gates delivery) ----
model Message {
  id          String       @id @default(cuid())
  senderId    String
  sender      User         @relation("MsgSender", fields: [senderId], references: [id], onDelete: Cascade)
  // One of these two says where the message went: a person, or a group. A
  // group message has no single recipient and no readAt — "who has read it" is
  // kept per member on FriendGroupMember.chatReadAt instead.
  recipientId String?
  recipient   User?        @relation("MsgRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  groupId     String?
  group       FriendGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  body        String       @db.Text
  createdAt   DateTime     @default(now())
  readAt      DateTime?

  @@index([recipientId, readAt]) // unread counts
  @@index([groupId, createdAt]) // a group's chat, newest first
  @@index([senderId, recipientId, createdAt]) // thread load
  @@index([recipientId, senderId, createdAt])
}

// Cached AI day plans, keyed per (lake, date, species). Shared across users
// (conditions are lake+date specific, not user specific). Regenerated as the
// fishing day approaches and the forecast firms up — `daysOutAtGen` records how
// far out the forecast was when generated.
model DayPlan {
  id           String         @id @default(cuid())
  lakeId       String
  lake         Lake           @relation(fields: [lakeId], references: [id], onDelete: Cascade)
  date         String // YYYY-MM-DD (the fishing day)
  species      String // a species name, or "any" — let the AI choose the target
  goal         String         @default("numbers") // numbers | trophy — changes the whole plan
  content      Json // { summary, timeline:[{time,advice}], lures:[], notes }
  daysOutAtGen Int // days between generation and the fishing day
  model        String?
  generatedAt  DateTime       @default(now())
  feedback     PlanFeedback[]

  @@unique([lakeId, date, species, goal])
  @@index([lakeId])
}

// One cached profile per lake. Granbury is seeded `hand_verified` and never
// overwritten by AI. `content` JSON: { summary, species[], seasonalCalendar, patterns, regsUrl }.
model LakeProfile {
  id          String            @id @default(cuid())
  lakeId      String            @unique
  lake        Lake              @relation(fields: [lakeId], references: [id], onDelete: Cascade)
  content     Json
  source      LakeProfileSource @default(ai)
  model       String?
  verified    Boolean           @default(false)
  generatedAt DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

// A user's saved lakes ("my lakes") + which one is home.
model UserLake {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lakeId  String
  lake    Lake     @relation(fields: [lakeId], references: [id], onDelete: Cascade)
  isHome  Boolean  @default(false)
  addedAt DateTime @default(now())

  @@unique([userId, lakeId])
  @@index([userId])
}

// Per-user misc storage the frontend already syncs via GET/PUT /api/kv/:key
// (theme, checklist, drive-time, and — in P1 — the app's JSON blobs). Keys are
// namespaced by lake on the client (e.g. "<lakeId>:trips"), so (userId, key) is unique.
model Kv {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

// ---- P2 social: normalized, shareable fishing data ----

model Trip {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lakeId       String
  lake         Lake        @relation(fields: [lakeId], references: [id], onDelete: Cascade)
  date         DateTime
  species      String?
  weight       Float?
  length       Float?
  lure         String?
  lat          Float?
  lon          Float?
  notes        String?     @db.Text
  weather      Json?
  visibility   Visibility  @default(private)
  groupId      String? // when visibility = group
  // Set when the angler enters this catch into a group tournament. Explicit on
  // purpose: a fish that happens to be caught during the window is not an
  // entry until its owner says so.
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  photos       Photo[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId, lakeId])
  @@index([tournamentId])
  @@index([lakeId, visibility])
}

model Spot {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lakeId     String
  lake       Lake       @relation(fields: [lakeId], references: [id], onDelete: Cascade)
  name       String
  lat        Float
  lon        Float
  notes      String?    @db.Text
  visibility Visibility @default(private)
  groupId    String? // when visibility = group
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId, lakeId])
  @@index([lakeId, visibility])
}

model Waypoint {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lakeId     String
  lake       Lake       @relation(fields: [lakeId], references: [id], onDelete: Cascade)
  name       String
  lat        Float
  lon        Float
  kind       String?
  visibility Visibility @default(private)
  groupId    String? // when visibility = group
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId, lakeId])
  @@index([lakeId, visibility])
}

// ---- P2 social: friends, groups, sharing prefs ----

model Friendship {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friendId    String
  friend      User             @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(pending)
  requestedBy String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, friendId])
  @@index([friendId])
}

model FriendGroup {
  id           String              @id @default(cuid())
  ownerId      String
  owner        User                @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  about        String?             @db.Text
  // What the owner decides for everyone:
  //   dataSharing  off      — this group is for talking, not spots
  //                optional — members choose what they share (the default)
  //                asked    — members are asked to share everything, but may refuse
  //   whoCanInvite owner | editors
  dataSharing  String              @default("optional")
  whoCanInvite String              @default("editors")
  createdAt    DateTime            @default(now())
  members      FriendGroupMember[]
  posts        Post[]
  tournaments  Tournament[]
  series       TournamentSeries[]
  messages     Message[]

  @@index([ownerId])
}

model FriendGroupMember {
  id             String      @id @default(cuid())
  groupId        String
  group          FriendGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId       String
  member         User        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // editor  — runs the group with the owner: invites, removes, moderates posts
  // collaborator — posts to the group page
  // member  — reads the page and comments
  role           String      @default("member")
  // An invitation, not a conscription: a membership starts `pending` and only
  // counts once the angler accepts. Rows that predate invitations are `active`,
  // which is what the column defaults to.
  status         String      @default("active") // pending | active | declined
  invitedById    String?
  invitedAt      DateTime?
  respondedAt    DateTime?
  // What this member shares WITH THIS GROUP, chosen when they accept. A record
  // still needs its own `visibility: group` to be shared at all; these are the
  // member's veto on top of that, per data type.
  shareSpots     Boolean     @default(true)
  shareCatches   Boolean     @default(true)
  shareWaypoints Boolean     @default(true)
  // Where this member had got to in the group's chat.
  chatReadAt     DateTime?
  addedAt        DateTime    @default(now())

  @@unique([groupId, memberId])
  @@index([memberId])
}

// A user's default sharing per data type; per-record `visibility` can override.
model SharingPref {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataType  ShareDataType
  scope     ShareScope    @default(none)
  groupIds  String[] // when scope = groups
  updatedAt DateTime      @updatedAt

  @@unique([userId, dataType])
}

// Client-side JavaScript errors, reported by the app. Without these a broken
// deploy is invisible: the page blanks on someone's phone and the server logs
// look perfectly healthy. Bounded — the sweep keeps only recent rows.
model ClientError {
  id        String   @id @default(cuid())
  message   String   @db.Text
  source    String? // file:line:col
  stack     String?  @db.Text
  url       String? // page the error happened on
  userAgent String?
  userId    String? // when the reporter was signed in
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Every model call, with what it cost. Without this, AI spend is invisible
// until the bill arrives — and there is no way to tell which feature is
// expensive. Cost is computed at call time from the rate table, so a later
// price change never rewrites history.
model AiUsage {
  id              String   @id @default(cuid())
  feature         String // day_plan | lake_profile | identify_catch
  model           String
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  cacheReadTokens Int      @default(0)
  webSearches     Int      @default(0) // billed per search on top of tokens
  costUsd         Float    @default(0)
  userId          String? // who triggered it, when known
  lakeId          String?
  ok              Boolean  @default(true)
  ms              Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([feature, createdAt])
}

// A fishing report about a lake — from an official agency feed, a page we
// fetched, or an angler who was actually there. These feed the day planner,
// which is the whole point: a report from this week beats any model's guess.
model LakeReport {
  id          String    @id @default(cuid())
  lakeId      String
  lake        Lake      @relation(fields: [lakeId], references: [id], onDelete: Cascade)
  source      String // agency | corps | web | angler
  sourceName  String? // "TPWD", or the angler's display name
  title       String?
  body        String    @db.Text
  url         String?
  publishedAt DateTime? // when the report is about, not when we stored it
  userId      String? // set when an angler posted it
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@unique([lakeId, url]) // one row per fetched item
  @@index([lakeId, publishedAt])
}

// Where reports come from. A source can be pinned to one lake or to a whole
// region (a state agency page that covers every lake in it).
model ReportSource {
  id            String    @id @default(cuid())
  name          String // "TPWD freshwater reports"
  url           String
  kind          String    @default("rss") // rss | html
  lakeId        String? // pinned to one lake...
  region        String? // ...or matched by lake region ("Texas")
  active        Boolean   @default(true)
  lastFetchedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([active])
}

// Every USACE project we know of, with coordinates. Built once from the CWMS
// location lists (one district is ~800KB, so this is emphatically a cached
// index, not a per-lake lookup) and refreshed monthly. Replaces a hand-written
// state-to-district map that was quietly wrong — it put Table Rock in the
// wrong district, so a famous Corps lake found nothing.
model CorpsLocation {
  id         String   @id @default(cuid())
  office     String
  name       String
  publicName String
  lat        Float
  lon        Float
  updatedAt  DateTime @updatedAt

  @@unique([office, name])
  @@index([lat, lon])
}

// Was the plan any good? The only measurement of output quality the app has —
// everything else measures inputs. Kept per user because one cached plan is
// served to several anglers, and stamped with the model that wrote it so
// "is the cheap model good enough" becomes a question with an answer.
model PlanFeedback {
  id        String   @id @default(cuid())
  planId    String
  plan      DayPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpful   Boolean
  note      String?  @db.Text
  model     String? // whichever model produced the plan being rated
  createdAt DateTime @default(now())

  @@unique([planId, userId])
  @@index([model, helpful])
}

// A photo of a catch. The bytes live in object storage; this row is the
// permission record. Photos inherit the visibility of the catch they belong to,
// and are served through the app rather than by a public URL — a link, once
// created, cannot be un-shared, which is exactly wrong for "friends only".
model Photo {
  id        String   @id @default(cuid())
  key       String   @unique // object key in the bucket
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId    String? // the catch it belongs to, once attached
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  postId    String? // or the post it belongs to
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  listingId String? // or the classified ad it belongs to
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  lakeId    String?
  mediaType String
  bytes     Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([tripId])
  @@index([postId])
  @@index([listingId])
  @@index([userId, createdAt])
}

// ---- P3 admin / community ----

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---- P3 admin Command Center ----

// Admin accounts use username + password + email MFA (separate from users'
// passwordless magic-link). Bootstrapped from env (ADMIN_USERNAME/PASSWORD/EMAIL).
model AdminUser {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String
  email        String
  createdAt    DateTime       @default(now())
  lastLoginAt  DateTime?
  sessions     AdminSession[]
  mfaCodes     AdminMfaCode[]
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  ip        String?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

model AdminMfaCode {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

// Runtime config set from the admin Settings GUI (DB overlay onto process.env).
// Secret values are encrypted at rest (AES-256-GCM, key = CONFIG_ENCRYPTION_KEY).
model AppConfig {
  key       String   @id
  value     String   @db.Text
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model ProfileContribution {
  id        String   @id @default(cuid())
  lakeId    String
  lake      Lake     @relation(fields: [lakeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  field     String
  content   String   @db.Text
  status    String   @default("pending") // pending | accepted | rejected
  createdAt DateTime @default(now())

  @@index([lakeId])
}

// ---------------------------------------------------------------------------
// Posts: the wall. A post is what an angler says on their own page or on a
// group's page — the part of the app that isn't a catch or a waypoint.
// ---------------------------------------------------------------------------
model Post {
  id         String       @id @default(cuid())
  authorId   String
  author     User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // A group post lives on that group's page and is visible to its members;
  // groupId null means it lives on the author's own page.
  groupId    String?
  group      FriendGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lakeId     String?
  lake       Lake?        @relation(fields: [lakeId], references: [id], onDelete: SetNull)
  body       String       @db.Text
  // private | friends | public — ignored for group posts, where the group is
  // the audience.
  visibility String       @default("friends")
  pinned     Boolean      @default(false)
  // Set the first time a post is edited, so a changed post can say so rather
  // than quietly rewriting what people already replied to.
  editedAt   DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  photos    Photo[]
  comments  PostComment[]
  reactions PostReaction[]

  @@index([authorId, createdAt])
  @@index([groupId, createdAt])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model PostReaction {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   String @default("like")

  @@unique([postId, userId])
}

// ---------------------------------------------------------------------------
// Classifieds. Gear changes hands constantly in fishing clubs; this is the
// board for it. A listing is visible to every signed-in angler — the whole
// point is reach — so it carries no visibility field, only a status.
// ---------------------------------------------------------------------------
model Listing {
  id         String    @id @default(cuid())
  sellerId   String
  seller     User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title      String
  body       String    @db.Text
  // Cents, so no float ever touches a price. null = "make an offer".
  priceCents Int?
  currency   String    @default("USD")
  category   String    @default("other") // rods | reels | electronics | boats | tackle | other
  condition  String? // new | like_new | good | fair | parts
  location   String? // free text: "Granbury, TX"
  lakeId     String?
  lake       Lake?     @relation(fields: [lakeId], references: [id], onDelete: SetNull)
  status     String    @default("active") // active | sold | withdrawn
  soldAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  // Bumping re-sorts without faking the creation date, so "listed 3 months ago"
  // stays honest.
  bumpedAt   DateTime  @default(now())
  photos     Photo[]

  @@index([status, bumpedAt])
  @@index([sellerId])
  @@index([category, status])
}

// ---------------------------------------------------------------------------
// Notifications. One row per thing that happened to you. Written by the action
// that caused them, never derived on read — a feed that has to recompute "what
// changed since you last looked" gets slower every month.
// ---------------------------------------------------------------------------
model Notification {
  id           String    @id @default(cuid())
  userId       String // who is being told
  user         User      @relation("NotifyRecipient", fields: [userId], references: [id], onDelete: Cascade)
  // who did it. Null for anything the system did on its own.
  actorId      String?
  actor        User?     @relation("NotifyActor", fields: [actorId], references: [id], onDelete: Cascade)
  // comment | like | friend_request | friend_accepted | group_added |
  // group_role | group_post | invite_accepted
  type         String
  postId       String?
  commentId    String?
  groupId      String?
  listingId    String?
  tournamentId String?
  // A short piece of the thing itself, captured at write time so the list can
  // render without joining four tables — and still reads correctly after the
  // original is deleted.
  snippet      String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Flags: a user telling us something here is wrong. Deliberately separate from
// blocking — blocking is "not for me", flagging is "not for anyone".
// ---------------------------------------------------------------------------
model ContentFlag {
  id         String    @id @default(cuid())
  reporterId String
  reporter   User      @relation("FlagReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String // post | comment | listing | user
  targetId   String
  reason     String // spam | scam | harassment | nudity | illegal | other
  note       String?   @db.Text
  // A copy of what was flagged, taken now: the author can delete the original
  // a second later, and then there is nothing left to review.
  snapshot   String?   @db.Text
  status     String    @default("open") // open | actioned | dismissed
  resolution String?   @db.Text
  // The reviewer is an admin, and AdminUser is a separate table from User —
  // so this is the admin's username, recorded plainly, not a foreign key.
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Invites. The one thing the app could not do: reach someone who is not here
// yet. An invite is an email address plus a code; accepting it makes the two
// anglers friends, which is the whole point of being invited by a person.
// ---------------------------------------------------------------------------
model Invite {
  id           String    @id @default(cuid())
  code         String    @unique
  inviterId    String
  inviter      User      @relation("InviteSender", fields: [inviterId], references: [id], onDelete: Cascade)
  email        String
  note         String?   @db.Text
  sentAt       DateTime?
  acceptedAt   DateTime?
  acceptedById String?
  acceptedBy   User?     @relation("InviteAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([inviterId, createdAt])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Tournaments. A group's own event: the owner sets it up, members say whether
// they are fishing it. Deliberately not a scoring engine — anglers settle
// results at the ramp, and a leaderboard nobody trusts is worse than none.
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// A season: the club's year. Individual tournaments hang off it and the
// standings are computed from their results — points per event, worst results
// dropped, and an angler of the year at the end. Every club trail already runs
// this on a spreadsheet; this is that spreadsheet.
// ---------------------------------------------------------------------------
model TournamentSeries {
  id         String      @id @default(cuid())
  groupId    String
  group      FriendGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String // "2026 Club Season"
  year       Int
  details    String?     @db.Text
  // points — placing in each event scores points, the way most club trails run
  // weight — the season is simply everyone's total weight added up
  scoring    String      @default("points")
  // First place scores this, second one step less, and so on — never below one
  // point, because weighing a fish always beats staying home.
  pointsTop  Int         @default(100)
  pointsStep Int         @default(1)
  // Best (events − dropWorst) count, so one blown Saturday does not end a season.
  dropWorst  Int         @default(0)
  status     String      @default("open") // open | done
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  events Tournament[]

  @@index([groupId, year])
}

model Tournament {
  id          String            @id @default(cuid())
  groupId     String
  group       FriendGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Which season this belongs to, if any. A one-off tournament has none.
  seriesId    String?
  series      TournamentSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  hostId      String
  host        User              @relation("TournamentHost", fields: [hostId], references: [id], onDelete: Cascade)
  name        String
  details     String?           @db.Text
  lakeId      String?
  lake        Lake?             @relation(fields: [lakeId], references: [id], onDelete: SetNull)
  // Where to meet, in words — a ramp name beats coordinates nobody reads.
  meetAt      String?
  startsAt    DateTime
  endsAt      DateTime
  species     String? // "Largemouth bass", or null for anything that swims
  // biggest_fish | heaviest_bag | most_fish | other
  format      String            @default("heaviest_bag")
  entryFee    String? // free text: "$20 a boat", "bring a dish"
  status      String            @default("open") // open | cancelled | done
  // The host's word on the outcome, written when they close it. The board is
  // computed from entered catches; this is for "Dave's 6.2 was foul-hooked".
  resultsNote String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  entries TournamentEntry[]
  catches Trip[]

  @@index([groupId, startsAt])
  @@index([seriesId])
}

model TournamentEntry {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // invited — asked, hasn't said
  // in / out — fishing it, or not
  // maybe    — an honest answer, and more useful than silence
  status       String     @default("invited")
  note         String?
  respondedAt  DateTime?
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, userId])
  @@index([userId, status])
}
