// ElavoFishAI — full data model, designed up front (P0) so later phases (social,
// admin, monetization) are additive migrations, not reshapes.
//
// Phase use:
//   P1  User, AuthToken, Session, RateLimit, Lake, LakeProfile, UserLake, Kv
//   P2  Trip, Spot, Waypoint (normalized + visibility), Friendship, FriendGroup(+Member), SharingPref
//   P3  AuditLog, ProfileContribution
//   P4  (future) marketplace + subscriptions — Role already has pro|guide and
//       Visibility already has `paid`; reserve Listing/Purchase/Entitlement/Payout/
//       Subscription as additive tables then.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  pro
  guide
  admin
}

enum AuthPurpose {
  login
  signup
}

enum GaugeSource {
  usgs
  manual
  none
}

enum LakeProfileSource {
  ai
  hand_verified
  community
}

// Sharing scale — social tiers now, `paid` reserved for the P4 marketplace.
enum Visibility {
  private
  friends
  group
  public
  paid
}

enum FriendshipStatus {
  pending
  accepted
  blocked
}

enum ShareScope {
  none
  friends
  groups
  public
}

enum ShareDataType {
  trips
  spots
  waypoints
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  displayName String
  username    String?   @unique
  avatarUrl   String?   @db.Text // data URL (client-resized square) or external URL
  role        Role      @default(user)
  status      String    @default("active") // active | suspended
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // ---- profile ----
  location        String? // e.g. "Granbury, TX"
  bio             String? @db.Text
  favoriteSpecies String? // e.g. "Largemouth Bass"
  favoriteLure    String? // e.g. "1/16 oz chartreuse jig"
  // ---- electronics ---- what the angler actually runs, so the app stops
  // assuming Garmin + LiveScope. null = never asked, "none" = fishes without.
  plotterBrand    String? // garmin | lowrance | humminbird | other | none
  ffsBrand        String? // livescope | activetarget | megalive | other | none
  hasBoat         Boolean? // null = never asked
  boatType        String? // bass boat | pontoon | kayak | jon boat | bank & wade ...
  yearsFishing    String? // free text band, e.g. "10+ years"
  onboardedAt     DateTime? // completed the first-run flow
  favoriteLakeId  String?
  favoriteLake    Lake?   @relation("UserFavoriteLake", fields: [favoriteLakeId], references: [id], onDelete: SetNull)

  // ---- discoverability ----
  // Who can find this angler by searching. `friends_of_friends` (the default)
  // means someone must share at least one accepted friend. `nobody` keeps them
  // out of search entirely — a request by exact email still reaches them,
  // because knowing the address is its own kind of introduction.
  discoverability String @default("friends_of_friends") // everyone | friends_of_friends | nobody

  // ---- messaging ----
  messagePrivacy   String    @default("friends") // everyone | friends | nobody
  sentMessages     Message[] @relation("MsgSender")
  receivedMessages Message[] @relation("MsgRecipient")

  sessions             Session[]
  userLakes            UserLake[]
  addedLakes           Lake[]                @relation("LakeAddedBy")
  trips                Trip[]
  spots                Spot[]
  waypoints            Waypoint[]
  kv                   Kv[]
  sharingPrefs         SharingPref[]
  ownedGroups          FriendGroup[]         @relation("GroupOwner")
  groupMemberships     FriendGroupMember[]
  friendshipsInitiated Friendship[]          @relation("FriendshipUser")
  friendshipsReceived  Friendship[]          @relation("FriendshipFriend")
  auditLogs            AuditLog[]
  profileContributions ProfileContribution[]
}

// Magic-link tokens. Unified login+signup: purpose distinguishes; displayName is
// captured when a brand-new email requests a link.
model AuthToken {
  id          String      @id @default(cuid())
  email       String
  tokenHash   String      @unique
  purpose     AuthPurpose @default(login)
  displayName String?
  expiresAt   DateTime
  usedAt      DateTime?
  ip          String?
  createdAt   DateTime    @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Bounded rate-limit buckets (e.g. "magiclink:<ip>") — swept, never grows forever.
model RateLimit {
  id          String   @id @default(cuid())
  bucket      String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// Lakes are GLOBAL and deduped — one row per real body of water, shared by all users.
model Lake {
  id          String      @id @default(cuid())
  name        String
  region      String? // state / province
  country     String?
  lat         Float
  lon         Float
  gaugeId     String?
  gaugeSource GaugeSource @default(none)
  fullPool    Float?
  bbox        String? // JSON [w,s,e,n]
  rampsJson   String? @db.Text // cached OSM boat ramps for this lake
  rampsAt     DateTime? // when that cache was filled
  osmRef      String?     @unique // e.g. "way/12345678"
  addedById   String?
  addedBy     User?       @relation("LakeAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  profile       LakeProfile?
  userLakes     UserLake[]
  trips         Trip[]
  spots         Spot[]
  waypoints     Waypoint[]
  dayPlans      DayPlan[]
  contributions ProfileContribution[]
  favoritedBy   User[]                @relation("UserFavoriteLake")

  @@index([name])
}

// ---- Direct messages (friends-only by default; per-user privacy setting gates delivery) ----
model Message {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("MsgSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("MsgRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String    @db.Text
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([recipientId, readAt]) // unread counts
  @@index([senderId, recipientId, createdAt]) // thread load
  @@index([recipientId, senderId, createdAt])
}

// Cached AI day plans, keyed per (lake, date, species). Shared across users
// (conditions are lake+date specific, not user specific). Regenerated as the
// fishing day approaches and the forecast firms up — `daysOutAtGen` records how
// far out the forecast was when generated.
model DayPlan {
  id           String   @id @default(cuid())
  lakeId       String
  lake         Lake     @relation(fields: [lakeId], references: [id], onDelete: Cascade)
  date         String // YYYY-MM-DD (the fishing day)
  species      String // a species name, or "any" — let the AI choose the target
  goal         String   @default("numbers") // numbers | trophy — changes the whole plan
  content      Json // { summary, timeline:[{time,advice}], lures:[], notes }
  daysOutAtGen Int // days between generation and the fishing day
  model        String?
  generatedAt  DateTime @default(now())

  @@unique([lakeId, date, species, goal])
  @@index([lakeId])
}

// One cached profile per lake. Granbury is seeded `hand_verified` and never
// overwritten by AI. `content` JSON: { summary, species[], seasonalCalendar, patterns, regsUrl }.
model LakeProfile {
  id          String            @id @default(cuid())
  lakeId      String            @unique
  lake        Lake              @relation(fields: [lakeId], references: [id], onDelete: Cascade)
  content     Json
  source      LakeProfileSource @default(ai)
  model       String?
  verified    Boolean           @default(false)
  generatedAt DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

// A user's saved lakes ("my lakes") + which one is home.
model UserLake {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lakeId  String
  lake    Lake     @relation(fields: [lakeId], references: [id], onDelete: Cascade)
  isHome  Boolean  @default(false)
  addedAt DateTime @default(now())

  @@unique([userId, lakeId])
  @@index([userId])
}

// Per-user misc storage the frontend already syncs via GET/PUT /api/kv/:key
// (theme, checklist, drive-time, and — in P1 — the app's JSON blobs). Keys are
// namespaced by lake on the client (e.g. "<lakeId>:trips"), so (userId, key) is unique.
model Kv {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

// ---- P2 social: normalized, shareable fishing data ----

model Trip {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lakeId     String
  lake       Lake       @relation(fields: [lakeId], references: [id], onDelete: Cascade)
  date       DateTime
  species    String?
  weight     Float?
  length     Float?
  lure       String?
  lat        Float?
  lon        Float?
  notes      String?    @db.Text
  weather    Json?
  visibility Visibility @default(private)
  groupId    String? // when visibility = group
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId, lakeId])
  @@index([lakeId, visibility])
}

model Spot {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lakeId     String
  lake       Lake       @relation(fields: [lakeId], references: [id], onDelete: Cascade)
  name       String
  lat        Float
  lon        Float
  notes      String?    @db.Text
  visibility Visibility @default(private)
  groupId    String? // when visibility = group
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId, lakeId])
  @@index([lakeId, visibility])
}

model Waypoint {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lakeId     String
  lake       Lake       @relation(fields: [lakeId], references: [id], onDelete: Cascade)
  name       String
  lat        Float
  lon        Float
  kind       String?
  visibility Visibility @default(private)
  groupId    String? // when visibility = group
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId, lakeId])
  @@index([lakeId, visibility])
}

// ---- P2 social: friends, groups, sharing prefs ----

model Friendship {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friendId    String
  friend      User             @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(pending)
  requestedBy String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, friendId])
  @@index([friendId])
}

model FriendGroup {
  id        String              @id @default(cuid())
  ownerId   String
  owner     User                @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime            @default(now())
  members   FriendGroupMember[]

  @@index([ownerId])
}

model FriendGroupMember {
  id       String      @id @default(cuid())
  groupId  String
  group    FriendGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId String
  member   User        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  addedAt  DateTime    @default(now())

  @@unique([groupId, memberId])
  @@index([memberId])
}

// A user's default sharing per data type; per-record `visibility` can override.
model SharingPref {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataType  ShareDataType
  scope     ShareScope    @default(none)
  groupIds  String[] // when scope = groups
  updatedAt DateTime      @updatedAt

  @@unique([userId, dataType])
}

// Client-side JavaScript errors, reported by the app. Without these a broken
// deploy is invisible: the page blanks on someone's phone and the server logs
// look perfectly healthy. Bounded — the sweep keeps only recent rows.
model ClientError {
  id        String   @id @default(cuid())
  message   String   @db.Text
  source    String? // file:line:col
  stack     String? @db.Text
  url       String? // page the error happened on
  userAgent String?
  userId    String? // when the reporter was signed in
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Every model call, with what it cost. Without this, AI spend is invisible
// until the bill arrives — and there is no way to tell which feature is
// expensive. Cost is computed at call time from the rate table, so a later
// price change never rewrites history.
model AiUsage {
  id           String   @id @default(cuid())
  feature      String // day_plan | lake_profile | identify_catch
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cacheReadTokens Int   @default(0)
  webSearches  Int      @default(0) // billed per search on top of tokens
  costUsd      Float    @default(0)
  userId       String? // who triggered it, when known
  lakeId       String?
  ok           Boolean  @default(true)
  ms           Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([feature, createdAt])
}

// ---- P3 admin / community ----

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---- P3 admin Command Center ----

// Admin accounts use username + password + email MFA (separate from users'
// passwordless magic-link). Bootstrapped from env (ADMIN_USERNAME/PASSWORD/EMAIL).
model AdminUser {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String
  email        String
  createdAt    DateTime       @default(now())
  lastLoginAt  DateTime?
  sessions     AdminSession[]
  mfaCodes     AdminMfaCode[]
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  ip        String?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

model AdminMfaCode {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

// Runtime config set from the admin Settings GUI (DB overlay onto process.env).
// Secret values are encrypted at rest (AES-256-GCM, key = CONFIG_ENCRYPTION_KEY).
model AppConfig {
  key       String   @id
  value     String   @db.Text
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model ProfileContribution {
  id        String   @id @default(cuid())
  lakeId    String
  lake      Lake     @relation(fields: [lakeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  field     String
  content   String   @db.Text
  status    String   @default("pending") // pending | accepted | rejected
  createdAt DateTime @default(now())

  @@index([lakeId])
}
