# ElavoFishAI — environment. Copy to .env for docker compose on the Mini.

# Postgres password (compose wires DATABASE_URL from this).
PG_PASSWORD=change-me-strong

# Public origin the app is reached at (used for magic-link URLs + Secure cookies).
# LAN example:  http://192.168.215.254:3100
PUBLIC_BASE_URL=

# Set true only behind HTTPS (a tunnel/proxy). LAN over http → false.
COOKIE_SECURE=false

# Dev/console magic-link mode: the sign-in link is returned + logged instead of
# emailed. This lets ANYONE who can reach the app sign in as ANY email address,
# so it is off by default and the link is only ever returned to a caller on the
# local network. Configure Resend below instead of turning this on.
DEV_SHOW_MAGIC_LINK=0

# A production build refuses to start with DEV_SHOW_MAGIC_LINK=1 unless this is
# also set. Only for a trusted LAN prototype with no email provider yet.
ALLOW_INSECURE_DEV_LOGIN=0

# Real magic-link + admin MFA email (replaces dev/console mode).
RESEND_API_KEY=
EMAIL_FROM=

# AI lake profiles (P1). Without a key, profiles stay pending; the engine still works.
ANTHROPIC_API_KEY=
AI_PROFILE_MODEL=claude-opus-4-8

# Admin Command Center (bootstrap the first admin; MFA code shows in dev mode)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong
ADMIN_EMAIL=you@example.com
# Encrypts config secrets at rest (openssl rand -hex 32)
CONFIG_ENCRYPTION_KEY=
